+      List<String> expected,
+    })>[
+      (
+        name: 'employee with employee profile',
+        user: employeeWithProfile,
+        expected: employeeDestinations,
+      ),
+      (
+        name: 'employee without employee profile',
+        user: employeeWithoutProfile,
+        expected: const <String>[
+          'Projetos e tarefas',
+          'Kanban',
+          'Configurações'
