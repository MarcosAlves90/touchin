+        await tester.pump(const Duration(milliseconds: 500));
+
+        expect(
+          visibleDestinations(tester, find.byType(Drawer)),
+          roleCase.expected,
+          reason: '${roleCase.name} on the mobile drawer',
+        );
+        expect(
+          find.descendant(
+            of: find.byType(Drawer),
+            matching: find.text('Sair do Sistema'),
+          ),
+          findsOneWidget,
+        );
+      });
+    }
+
+    testWidgets(
