          "REQ-01",
          "REQ-02"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-02",
        "statement": "Existing Kanban page, board and accessibility tests and configured gates pass; persisted contract equals the lock byte-for-byte.",
