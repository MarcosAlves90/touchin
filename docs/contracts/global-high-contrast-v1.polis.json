  "specification": {
    "objective": "Provide optional site-wide high contrast in accessibility settings and remove the forced team contrast theme.",
    "requirements": [
      {
        "id": "REQ-01",
        "statement": "Offer keyboard accessible optional global high contrast for text, surfaces and controls in light and dark, preserving theme choice, semantic states and focus."
      },
      {
        "id": "REQ-02",
        "statement": "Use normal controls on the team page by default without weakening semantic text contrast."
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC-01",
        "statement": "Tests measure actual foreground, surfaces and control contrast, light and dark, navigation, nested dialogs, keyboard focus and reset.",
        "requirements": [
          "REQ-01"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-02",
        "statement": "Team page inherits the normal theme by default and existing accessibility tests remain valid.",
        "requirements": [
          "REQ-02"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-03",
        "statement": "docs/contracts/global-high-contrast-v1.polis.json is byte-for-byte identical to the external lock.",
        "requirements": [
          "REQ-01"
        ],
        "proof": "regression"
      }
    ],
    "invariants": [
      {
        "id": "INV-01",
        "statement": "Preserve accessible semantic colors, focus, text scaling, motion settings, existing theme mode and audit behavior."
      }
    ],
    "forbidden_states": [
      {
        "id": "FORB-01",
        "statement": "Forced high contrast on team by default or inaccessible controls."
      }
    ],
    "inputs": [
      {
        "id": "IN-01",
        "statement": "Theme mode, accessibility settings and routes."
      }
    ],
    "outputs": [
      {
        "id": "OUT-01",
        "statement": "Optional high contrast across the application."
      }
    ],
    "failure_semantics": [
      {
        "id": "FAIL-01",
        "statement": "Tests fail when contrast cannot be enabled or reverted."
      }
    ]
  },
