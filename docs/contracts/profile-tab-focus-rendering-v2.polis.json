  "specification": {
    "objective": "Supersedes profile-tab-focus-rendering-v1: characterize actual rendered keyboard focus border pixels and stable geometry without network, using licensed genuine Poppins fixtures; no production behavior changes.",
    "requirements": [
      {
        "id": "REQ-001",
        "statement": "Test actual rendered focus border pixels and contrast on selected and unselected profile tabs without network, with genuine licensed Poppins font assets."
      },
      {
        "id": "REQ-002",
        "statement": "Test tab geometry, semantics, keyboard traversal and activation across light and dark, normal and high contrast, mobile and desktop."
      },
      {
        "id": "REQ-003",
        "statement": "Archive the locked v2 contract byte-identically; preserve fixture provenance and OFL license."
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC-001",
        "statement": "Widget tests compare rendered pixels and tab rectangles before and after keyboard focus and activation, exercising selection and semantics across themes and viewports.",
        "requirements": [
          "REQ-001",
          "REQ-002"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-002",
        "statement": "Archived v2 contract is byte-identical to locked contract, and Poppins fixtures include pinned upstream provenance and OFL license.",
        "requirements": [
          "REQ-003"
        ],
        "proof": "regression"
      }
    ],
    "invariants": [
      {
        "id": "INV-001",
        "statement": "No global changes or changes to unrelated tabs, content or behavior."
      }
    ],
    "forbidden_states": [
      {
        "id": "FORB-001",
        "statement": "Focus and selection are visually indistinguishable."
      }
    ],
    "inputs": [
