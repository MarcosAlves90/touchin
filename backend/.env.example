TOUCHIN_TOKEN_SECRET=replace-with-a-long-random-token-secret
TOUCHIN_ENCRYPTION_SECRET=replace-with-a-different-long-random-encryption-secret
TOUCHIN_DATABASE_URL=sqlite:///./touchin.db
TOUCHIN_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080
TOUCHIN_TIMEZONE=America/Sao_Paulo
TOUCHIN_ENFORCE_HTTPS=false
TOUCHIN_BOOTSTRAP_DATABASE_ON_STARTUP=true
TOUCHIN_SEED_ON_STARTUP=true
TOUCHIN_SEED_ADMIN_PASSWORD=replace-with-a-seed-admin-password
TOUCHIN_BREVO_API_KEY=
TOUCHIN_BREVO_SENDER_EMAIL=
TOUCHIN_BREVO_SENDER_NAME=TouchIn
TOUCHIN_BREVO_WELCOME_ENABLED=true
